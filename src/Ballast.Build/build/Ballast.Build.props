<Project>

  <!--
    Ballast.Build: the shared settings an app or library takes from one package. It is imported before the project's own body, so
    any value the project sets after this file wins. The package has no assembly: it only adds these settings, the analyzer
    severities (Ballast.Build.globalconfig) and the build stamp (Ballast.Build.targets).
  -->

  <!-- Language and analysis. The analyzers are on so that correctness rules are enforced at build time, not found by review. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    NuGet audit. Every package a project uses, directly or through another, is checked for a known vulnerability at restore. A
    moderate, high or critical advisory fails the build (NU1902, NU1903, NU1904); a low one is shown as a warning (NU1901). The app
    decides its own exceptions in its own project, with the reason beside them, never in this file.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!--
    The analyzer severities. A global analyzer config is read for every file of the project, without a section header, and the
    project's own .editorconfig (the file header and the style rules) is the app's to keep.
  -->
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)Ballast.Build.globalconfig" />
  </ItemGroup>

</Project>
