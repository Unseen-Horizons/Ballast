<Project>
  <!--
    Central package management. Every package version is set here, once, so a bump cannot drift between
    projects. Add a package here, then reference it without a Version in the project file.

    The six basic libraries depend on no package. The packages below are for the libraries that need one (each in its
    own labelled group), for the test projects and for Source Link, which only CI uses.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Ballast.Health (Entity Framework Core, for the database and schema checks)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Test projects (Microsoft.Testing.Platform, see global.json)">
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup Label="Ballast.Health tests (an in-memory web host, and SQL Server for the schema check)">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- Transitive, through Microsoft.Data.SqlClient. 10.0.0 to 10.0.12 have GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7
         (moderate); 10.0.13 is the first patched version, so it is pinned here. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Build-time, CI only">
    <!-- The 10.0.x line of the .NET SDK pinned in global.json. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
</Project>
