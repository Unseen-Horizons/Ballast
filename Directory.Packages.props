<Project>
  <!--
    Central package management. Every package version is set here, once, so a bump cannot drift between
    projects. Add a package here, then reference it without a Version in the project file.

    The six basic libraries depend on no package. Ballast.Http depends on the Microsoft.Extensions packages in its own
    group below. The rest of the packages are for the test projects and for Source Link, which only CI uses.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Test projects (Microsoft.Testing.Platform, see global.json)">
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup Label="Ballast.Http (outbound HTTP; the .NET 10 GA line, see the part plan)">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="Build-time, CI only">
    <!-- The 10.0.x line of the .NET SDK pinned in global.json. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
</Project>
