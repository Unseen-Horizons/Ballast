<Project>
  <!--
    Central package management. Every package version is set here, once, so a bump cannot drift between
    projects. Add a package here, then reference it without a Version in the project file.

    The six basic libraries depend on no package. The server libraries use the packages in the "Server libraries"
    group. Microsoft packages are at the .NET 10 GA version (10.0.0), so an app on a later 10.0.x patch never meets a
    downgrade error; a later version is used only where a security advisory requires it, with the reason beside it.
    With transitive pinning on, every version listed here also pins that package wherever a library pulls it in, and
    the pinned package becomes a direct dependency of the packed library. So a package only tests need goes in a test
    group only when no library pulls it in.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Server libraries">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- Transitive, through Microsoft.Data.SqlClient. 10.0.0 to 10.0.12 have GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7
         (moderate); 10.0.13 is the first patched version, so it is pinned here. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="MAUI library (Ballast.Maui: the android and windows targets)">
    <!-- The same versions GetThere pins, so the app and the library resolve one MAUI and one AdMob binding. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Plugin.AdMob" Version="10.0.90" />
    <!-- The Kotlin extension (Ktx) bindings on the AndroidX releases MAUI resolves, as GetThere pins them. A Ktx binding left on an older release
         than its base package makes NuGet report NU1608 on the android target. Bump them together with MAUI. -->
    <PackageVersion Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Common.Java8" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup Label="Test projects (Microsoft.Testing.Platform, see global.json)">
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup Label="Tests of the server libraries (an in-memory web host, and SQL Server)">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Label="App attestation (server): Play Integrity verdicts and the session token">
    <!-- Google's client libraries, Apache-2.0. The Play Integrity client is the one GetThere has used since 2026-10-05. -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageVersion Include="Google.Apis.PlayIntegrity.v1" Version="1.76.0.4270" />
    <!-- Microsoft.IdentityModel has its own version line (not 10.0.x). The session token is signed and validated with it. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>
  <ItemGroup Label="Build-time task of Ballast.Translations (private to that package, not a runtime dependency)">
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.0.2" />
  </ItemGroup>
  <ItemGroup Label="Build-time, CI only">
    <!-- The 10.0.x line of the .NET SDK pinned in global.json. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>
</Project>
