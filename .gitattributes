###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

###############################################################################
# Check C# files out with CRLF on every platform.
#
# .editorconfig sets end_of_line = crlf under [*], and `dotnet format
# --verify-no-changes` enforces it. With only `text=auto` above, a Linux
# checkout gets LF for every file, and the lint step reports an ENDOFLINE error
# on every line of every C# file. Pinning the checkout keeps the working tree
# agreeing with .editorconfig everywhere. Files are still stored LF-normalised
# in the repository.
###############################################################################
*.cs text eol=crlf

###############################################################################
# Markdown is LF-canonical. A document committed CRLF would turn every later
# touch into a whole-file diff. .editorconfig's end_of_line = lf for *.md keeps
# an editor from saving CRLF back.
###############################################################################
*.md text eol=lf
